# Copy these names into your local environment. Never commit actual secrets.
DB_URL=jdbc:mysql://localhost:3306/crm_dashboard_demo
DB_USERNAME=root
DB_PASSWORD=replace_with_your_database_password
JWT_SECRET=replace_with_at_least_32_random_characters

# Optional production WebRTC relay
CALL_TURN_URL=
CALL_TURN_USERNAME=
CALL_TURN_CREDENTIAL=

# Required only for LiveKit group calls
LIVEKIT_ENABLED=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Temporary development-only user override
CHAT_DEV_USER_OVERRIDE_ENABLED=false
CHAT_DEFAULT_DEV_USER_ID=1
